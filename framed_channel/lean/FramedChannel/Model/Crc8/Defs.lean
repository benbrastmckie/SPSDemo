/-- The table step, made total with `getD` (the index is always below 256, so the default is
never read). -/
def stepTable (crc b : BitVec 8) : BitVec 8 := table.getD (crc ^^^ b).toNat 0

def crc8Bits (bs : List (BitVec 8)) : BitVec 8 := bs.foldl stepBits 0

def crc8Table (bs : List (BitVec 8)) : BitVec 8 := bs.foldl stepTable 0

/-- The component tag naming the table-free bitwise loop. -/
structure Bitwise where

/-- The component tag naming the 256-entry table lookup. -/
structure Tabled where

instance instChecksumModelBitwise : ChecksumModel Bitwise where
  step := stepBits
  seed := 0
  digest := crc8Bits

instance instChecksumModelTabled : ChecksumModel Tabled where
  step := stepTable
  seed := 0
  digest := crc8Table

end FramedChannel.Crc8
