/-!
# Model/Crc8/Defs: the checksum definitions

`[HAND-WRITTEN: model; bridged]` -- the definitions half of `Model/Crc8/Theorems.lean`: the polynomial, the
bitwise step, the 256-entry table and its step, both folds, the component tags `Bitwise` and
`Tabled` and their `ChecksumModel` instances. It holds definitions only, so that the Challenge
module `FramedChannelChallenge.Crc8` can import them without importing a registered theorem.
-/

namespace FramedChannel.Crc8

def poly : BitVec 8 := 0x07#8

/-- One iteration of the polynomial loop: shift left; if the bit shifted out was set, xor the
polynomial in. -/
def shift1 (c : BitVec 8) : BitVec 8 :=
  if c.msb then (c <<< 1) ^^^ poly else c <<< 1

/-- The eight polynomial iterations of the inner loop, unrolled. -/
def round (c : BitVec 8) : BitVec 8 :=
  shift1 (shift1 (shift1 (shift1 (shift1 (shift1 (shift1 (shift1 c)))))))

/-- The per-byte step: xor the byte in, then the eight iterations. -/
def stepBits (crc b : BitVec 8) : BitVec 8 := round (crc ^^^ b)

